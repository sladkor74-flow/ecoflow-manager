{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "suggerimento_lunedi_predittivita",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "analisi_settimanale": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analisiSettimanalePredittiva"
          },
          "then": "end",
          "x-base44": {
            "title": "Fissa il programma della settimana dopo",
            "description": "Fissa i viaggi di secondaria della settimana dopo, stoccaggio per impianto, e non tocca quelli corretti a mano"
          }
        }
      }
    ]
  },
  "description": "Ogni mercoledì alle 8:00 fissa il programma delle secondarie di rete della settimana dopo, stoccaggio per impianto, sui dati della settimana scorsa (i formulari si registrano il lunedì). Il programma si legge nel modulo Predittività Secondarie, accanto al fatto; le righe corrette a mano dall'amministratore restano com'erano. Durante un caricamento non scrive niente: ripassa alle 14:00, e un programma gia' fissato non lo rifa'.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8,14 * * 3",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Programma del Mercoledì Predittività"
}
