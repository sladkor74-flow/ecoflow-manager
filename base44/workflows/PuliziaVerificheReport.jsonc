{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pulizia_verifiche_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "alleggerisci_documenti": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alleggerisciDocumenti",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Alleggerisce i documenti dei fornitori",
            "description": "Ai documenti caricati da oltre quaranta giorni toglie le righe lette e il confronto riga per riga, e lascia i numeri di sintesi e la storia scritta"
          }
        }
      }
    ]
  },
  "name": "Alleggerimento Documenti",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Ogni notte alle 3:15 toglie il dettaglio ai documenti dei fornitori caricati da oltre quaranta giorni: verifiche dei report settimanali, quadrature FIR, consuntivi, liste degli assegnati e controlli dell'evasione. Il record non si cancella: restano i numeri di sintesi e la storia scritta"
}
