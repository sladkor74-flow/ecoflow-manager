{
  "name": "Alert Engine Auto-Run",
  "description": "Esegue il motore di alert quando un caricamento di Secondarie, Primarie (Rete/ACI e Assegnati), Terziarie e' concluso, e quando si salvano schede di Extra Raccolta (la riga 'extra_raccolta' del registro, dal 22/09/2026: le date obbligatorie dell'extra raccolta si rivalutano da sole); dopo le primarie ricontrolla anche i target mensili. La riga del registro delle primarie nasce 'in_corso' mentre l'archivio si svuota e si riscrive, e prende l'esito solo alla fine: il motore parte li', su 'create' o su 'update', mai su un archivio in riscrittura. Parte su 'successo' e 'parziale' (caricamento finito: l'archivio e' quello che leggono tutti i moduli), non su 'in_corso' ne' su 'errore' (archivio vuoto o a meta').",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "UploadLog",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ ((.trigger.data.tipo_file // \"\") | IN(\"secondarie\",\"primarie_rete\",\"primarie_aci\",\"terziarie\",\"assegnati\",\"primarie\",\"extra_raccolta\")) and ((.trigger.data.esito // \"\") | IN(\"successo\",\"parziale\")) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_engine_auto_run",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_tipo": {
          "switch": [
            {
              "when": "${ .trigger.data.tipo_file == \"primarie\" }",
              "then": "run_rete"
            },
            {
              "when": "${ true }",
              "then": "run_single"
            }
          ],
          "x-base44": {
            "title": "Verifica tipo file"
          }
        }
      },
      {
        "run_rete": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAlertEngine",
            "args": {
              "modulo": "primarie_rete"
            }
          },
          "then": "run_aci",
          "x-base44": {
            "title": "Alert su Primarie Rete"
          }
        }
      },
      {
        "run_aci": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAlertEngine",
            "args": {
              "modulo": "primarie_aci"
            }
          },
          "then": "run_assegnati",
          "x-base44": {
            "title": "Alert su Primarie ACI"
          }
        }
      },
      {
        "run_assegnati": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAlertEngine",
            "args": {
              "modulo": "assegnati"
            }
          },
          "then": "run_target",
          "x-base44": {
            "title": "Alert sugli Assegnati",
            "description": "Il file unico delle primarie riscrive anche gli assegnati di rete"
          }
        }
      },
      {
        "run_target": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkTargetAlerts",
            "args": {
              "crea_alerts": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Ricontrolla i target mensili",
            "description": "Apre, aggiorna e chiude gli alert di target sul raccolto appena caricato, anche per il mese precedente"
          }
        }
      },
      {
        "run_single": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAlertEngine",
            "args": {
              "modulo": "${ .trigger.data.tipo_file }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Esegui motore alert"
          }
        }
      }
    ]
  }
}
