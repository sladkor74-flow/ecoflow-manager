{
  "name": "ImpiantoTargetSecondaria",
  "type": "object",
  "properties": {
    "nome_impianto": {
      "type": "string"
    },
    "target": {
      "type": "number",
      "description": "Target quantitativo (kg) - per impianti doppio ruolo rappresenta la quota impianto (primarie imp)"
    },
    "totale_capacity_kg": {
      "type": "number",
      "description": "Capacita' totale annua (kg) per impianti doppio ruolo (es. T-CYCLE: 1.300.000 = 1.050.000 impianto + 250.000 stoccaggio)"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date",
      "description": "Data obiettivo (default 18 dicembre)"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "nome_impianto",
    "target"
  ]
}