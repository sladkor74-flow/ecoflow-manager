{
  "name": "ImpiantoTargetSecondaria",
  "type": "object",
  "properties": {
    "nome_impianto": {
      "type": "string"
    },
    "target": {
      "type": "number",
      "description": "Target quantitativo (kg) - per impianti doppio ruolo rappresenta la quota impianto (primarie imp)"
    },
    "totale_capacity_kg": {
      "type": "number",
      "description": "Capacita' totale annua (kg) per impianti doppio ruolo (es. T-CYCLE: 1.300.000 = 1.050.000 impianto + 250.000 stoccaggio)"
    },
    "regione": {
      "type": "string",
      "description": "Regione di pertinenza dell'impianto (auto-derivata da mappatura manuale nota, sola lettura)"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date",
      "description": "Data obiettivo (default 18 dicembre)"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "anno": {
      "type": "number",
      "description": "Anno della predittivita' a cui vale il record (26/09/2026): ogni anno ha i suoi impianti, stoccaggi e fornitori, copiati dall'anno prima e confermati. Un record senza anno vale per il 2026, l'anno in cui la predittivita' e' nata."
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "nome_impianto",
    "target"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}