{
  "name": "EsercitazioneRT",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "simulazione",
        "allenamento",
        "ripasso"
      ],
      "default": "simulazione"
    },
    "verifica": {
      "type": "string",
      "enum": [
        "iniziale",
        "aggiornamento"
      ]
    },
    "modulo": {
      "type": "string",
      "description": "generale, cat145, cat8, cat9 o cat10"
    },
    "banca": {
      "type": "string",
      "description": "Banca dati dei quiz, per esempio iniziale-cat145"
    },
    "versione_banca": {
      "type": "string"
    },
    "materia": {
      "type": "string"
    },
    "domande": {
      "type": "number"
    },
    "esatte": {
      "type": "number"
    },
    "errate": {
      "type": "number"
    },
    "omesse": {
      "type": "number"
    },
    "punteggio": {
      "type": "number",
      "description": "+1 per risposta esatta, -0,5 per errata, 0 per omessa"
    },
    "soglia": {
      "type": "number"
    },
    "superata": {
      "type": "boolean"
    },
    "durata_secondi": {
      "type": "number"
    },
    "iniziata_il": {
      "type": "string",
      "format": "date-time"
    },
    "terminata_il": {
      "type": "string",
      "format": "date-time"
    },
    "risposte_json": {
      "type": "string",
      "description": "[{ id, scelta, esatta }]: scelta e' il testo scelto, vuoto se omessa"
    }
  },
  // L'esercitazione del corso RT e' l'altra scrittura di un utente non
  // amministratore (src/lib/permessi.js, ENTITA_LIBERE), e il livello
  // "consultazione" ha il permesso esplicito di usarla.
  //
  // Il filtro in lettura, messo dalla scansione della piattaforma il
  // 01/10/2026, chiudeva una fuga vera: con read: true ogni utente vedeva nella
  // tabella intitolata "Le tue esercitazioni" i punteggi degli altri, il
  // contatore delle simulazioni superate li sommava, e il ripasso degli errori
  // gli riproponeva i quiz sbagliati da qualcun altro. Si tiene.
  //
  // La condizione sulla CREATE invece si toglie: non protegge niente - l'app non
  // scrive created_by_id, lo mette la piattaforma, quindi nessuno puo' intestare
  // un'esercitazione a un altro - e rischia tutto, perche' se il motore valuta
  // la condizione sul payload (dove created_by_id non c'e' ancora) ogni consegna
  // fallisce e la prova appena svolta si perde con un "Risultato non salvato".
  // Una condizione che non aggiunge difese e puo' far perdere dati non si tiene.
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}