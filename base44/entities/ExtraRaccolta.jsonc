{
  "name": "ExtraRaccolta",
  "type": "object",
  "properties": {
    "id_ordine": {
      "type": "string",
      "description": "ID ordine / riferimento univoco"
    },
    "stato": {
      "type": "string",
      "description": "assegnato o terminato. In fatturazione entrano solo i terminati, nel mese della fine trasporto (giorno italiano); un terminato ha sempre le date di immissione, inizio e fine trasporto"
    },
    "ordine_immesso_il": {
      "type": "string",
      "format": "date-time"
    },
    "id_cliente": {
      "type": "number"
    },
    "ragione_sociale": {
      "type": "string"
    },
    "id_pdr": {
      "type": "number"
    },
    "punto_di_raccolta": {
      "type": "string"
    },
    "indirizzo": {
      "type": "string"
    },
    "cap": {
      "type": "string"
    },
    "comune": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "codice_regione": {
      "type": "number"
    },
    "macroarea": {
      "type": "string"
    },
    "codice_prodotto": {
      "type": "string"
    },
    "prodotto": {
      "type": "string"
    },
    "classe": {
      "type": "string"
    },
    "cer": {
      "type": "string"
    },
    "tipo_contenitori": {
      "type": "string"
    },
    "quantita_richiesta": {
      "type": "number"
    },
    "quantita_ritirata": {
      "type": "number"
    },
    "peso_stimato": {
      "type": "number"
    },
    "peso_effettivo": {
      "type": "number"
    },
    "key_account": {
      "type": "string"
    },
    "partner_operativo": {
      "type": "string"
    },
    "id_partner_operativo": {
      "type": "number"
    },
    "id_trasportatore": {
      "type": "number"
    },
    "trasportatore": {
      "type": "string"
    },
    "id_destinazione": {
      "type": "number"
    },
    "tipo_destinazione": {
      "type": "string"
    },
    "destinazione": {
      "type": "string"
    },
    "automezzo": {
      "type": "string"
    },
    "rimorchio": {
      "type": "string"
    },
    "distanza": {
      "type": "number"
    },
    "trasporto_iniziato_il": {
      "type": "string",
      "format": "date-time"
    },
    "trasporto_finito_il": {
      "type": "string",
      "format": "date-time"
    },
    "ordine_chiuso_il": {
      "type": "string",
      "format": "date-time"
    },
    "numero_fir": {
      "type": "string"
    },
    "numero_ordine_interno": {
      "type": "string"
    },
    "regioni": {
      "type": "string"
    },
    "mese": {
      "type": "string"
    },
    "settimane": {
      "type": "number"
    },
    "anno": {
      "type": "number"
    },
    "sigla": {
      "type": "string"
    },
    "regione": {
      "type": "string"
    },
    "tipologia_trasporto": {
      "type": "string",
      "description": "Progetto o campagna di riferimento, es. PFU ZERO - MAREVIVO"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "primaria",
        "secondaria"
      ],
      "default": "primaria",
      "description": "Primaria: raccolta dal produttore verso un impianto o uno stoccaggio. Secondaria: trasferimento da uno stoccaggio a un impianto. Gli interventi inseriti prima di questo campo sono primarie"
    },
    "stoccaggio": {
      "type": "string",
      "description": "Stoccaggio di partenza, solo per le secondarie"
    },
    "produttore": {
      "type": "string",
      "description": "Soggetto da cui si raccoglie; enti esterni non in anagrafica PDR"
    },
    "prezzo_attivo_t": {
      "type": "number",
      "default": 0,
      "description": "Prezzo in euro per tonnellata fatturato a Ecotyre. Zero o vuoto: vale la tariffa base Ecotyre dell'anno (la EXTRA_RACCOLTA attiva in tabella, altrimenti 202 euro/t nel 2026). Le secondarie non si fatturano"
    },
    "sovracosto_raccolta": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro da aggiungere in fattura"
    },
    "sovracosto_trasporto": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro"
    },
    "sovracosto_trattamento": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro"
    },
    "costo_raccolta_t": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per tonnellata da pagare al raccoglitore. Lo scrive l'amministratore prima di passare l'intervento a terminato; la passiva paga questo e non ripiega mai sulle tariffe di rete"
    },
    "costo_stoccaggio_t": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per tonnellata da pagare allo stoccaggio. Scritto a mano sull'intervento, come la raccolta"
    },
    "costo_trattamento_t": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per tonnellata da pagare all'impianto. Scritto a mano sull'intervento, come la raccolta"
    },
    "costo_trasporto_viaggio": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per il VIAGGIO da pagare al trasportatore di questo intervento, non a tonnellata. Lo scrive l amministratore sull intervento come gli altri costi. Serviva: nel foglio della fatturazione passiva dell amministrazione il blocco dell extra raccolta ha la colonna PREZZO (Euro/viaggio) e nel gestionale non c era nessun campo, quindi il trasporto di un intervento non si poteva scrivere e non si pagava - nemmeno quello delle secondarie, che sono trasferimenti da uno stoccaggio a un impianto e non hanno un costo di raccolta"
    },
    "sovracosto_pagato_raccoglitore": {
      "type": "number",
      "default": 0,
      "description": "SOVRACOSTO CHE SI PAGA AL RACCOGLITORE dell intervento, cioe al suo trasportatore: costi imprevisti che ha sostenuto nella raccolta. Importo fisso in euro, non a tonnellata. Precisazione dell utente del 03/10/2026: un sovracosto della passiva ha sempre un padrone, e e il raccoglitore o l impianto. Non confonderlo con sovracosto_raccolta, che invece si aggiunge a quello che si FATTURA a Ecotyre. La spiegazione in note_costi e obbligatoria: un costo imprevisto che finisce in fattura a un fornitore deve dire perche"
    },
    "sovracosto_pagato_impianto": {
      "type": "number",
      "default": 0,
      "description": "SOVRACOSTO CHE SI PAGA ALL IMPIANTO di destinazione, quello che deve trattare o triturare: costi imprevisti del trattamento, per esempio la pulizia di PFU sporchi prima di triturarli (esempio dell utente, 03/10/2026). Importo fisso in euro, non a tonnellata. Non confonderlo con sovracosto_trattamento, che e del ricavo. La spiegazione in note_costi e obbligatoria"
    },
    "costo_pulizia": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro. SENZA PADRONE: la fatturazione passiva non sa a chi fatturarlo e lo dichiara. Dal 03/10/2026, se quell onere spetta al raccoglitore o all impianto si scrive in sovracosto_pagato_raccoglitore o sovracosto_pagato_impianto, e allora la passiva lo paga. Resta per i dati degli interventi gia scritti"
    },
    "costi_aggiuntivi": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro per oneri non riconducibili alle voci precedenti. SENZA PADRONE, come costo_pulizia: la passiva lo dichiara e non lo fattura a nessuno"
    },
    "note_costi": {
      "type": "string",
      "description": "Spiegazione obbligatoria quando costi_aggiuntivi o costo_pulizia > 0"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id_ordine"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}