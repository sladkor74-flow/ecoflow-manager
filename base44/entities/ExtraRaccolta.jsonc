{
  "name": "ExtraRaccolta",
  "type": "object",
  "properties": {
    "id_ordine": {
      "type": "string",
      "description": "ID ordine / riferimento univoco"
    },
    "stato": {
      "type": "string"
    },
    "ordine_immesso_il": {
      "type": "string",
      "format": "date-time"
    },
    "id_cliente": {
      "type": "number"
    },
    "ragione_sociale": {
      "type": "string"
    },
    "id_pdr": {
      "type": "number"
    },
    "punto_di_raccolta": {
      "type": "string"
    },
    "indirizzo": {
      "type": "string"
    },
    "cap": {
      "type": "string"
    },
    "comune": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "codice_regione": {
      "type": "number"
    },
    "macroarea": {
      "type": "string"
    },
    "codice_prodotto": {
      "type": "string"
    },
    "prodotto": {
      "type": "string"
    },
    "classe": {
      "type": "string"
    },
    "cer": {
      "type": "string"
    },
    "tipo_contenitori": {
      "type": "string"
    },
    "quantita_richiesta": {
      "type": "number"
    },
    "quantita_ritirata": {
      "type": "number"
    },
    "peso_stimato": {
      "type": "number"
    },
    "peso_effettivo": {
      "type": "number"
    },
    "key_account": {
      "type": "string"
    },
    "partner_operativo": {
      "type": "string"
    },
    "id_partner_operativo": {
      "type": "number"
    },
    "id_trasportatore": {
      "type": "number"
    },
    "trasportatore": {
      "type": "string"
    },
    "id_destinazione": {
      "type": "number"
    },
    "tipo_destinazione": {
      "type": "string"
    },
    "destinazione": {
      "type": "string"
    },
    "automezzo": {
      "type": "string"
    },
    "rimorchio": {
      "type": "string"
    },
    "distanza": {
      "type": "number"
    },
    "trasporto_iniziato_il": {
      "type": "string",
      "format": "date-time"
    },
    "trasporto_finito_il": {
      "type": "string",
      "format": "date-time"
    },
    "ordine_chiuso_il": {
      "type": "string",
      "format": "date-time"
    },
    "numero_fir": {
      "type": "string"
    },
    "numero_ordine_interno": {
      "type": "string"
    },
    "regioni": {
      "type": "string"
    },
    "mese": {
      "type": "string"
    },
    "settimane": {
      "type": "number"
    },
    "anno": {
      "type": "number"
    },
    "sigla": {
      "type": "string"
    },
    "regione": {
      "type": "string"
    },
    "tipologia_trasporto": {
      "type": "string",
      "description": "Progetto o campagna di riferimento, es. PFU ZERO - MAREVIVO"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "primaria",
        "secondaria"
      ],
      "default": "primaria",
      "description": "Primaria: raccolta dal produttore verso un impianto o uno stoccaggio. Secondaria: trasferimento da uno stoccaggio a un impianto. Gli interventi inseriti prima di questo campo sono primarie"
    },
    "stoccaggio": {
      "type": "string",
      "description": "Stoccaggio di partenza, solo per le secondarie"
    },
    "produttore": {
      "type": "string",
      "description": "Soggetto da cui si raccoglie; enti esterni non in anagrafica PDR"
    },
    "prezzo_attivo_t": {
      "type": "number",
      "default": 0,
      "description": "Prezzo in euro per tonnellata fatturato al cliente"
    },
    "sovracosto_raccolta": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro da aggiungere in fattura"
    },
    "sovracosto_trasporto": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro"
    },
    "sovracosto_trattamento": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro"
    },
    "costo_raccolta_t": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per tonnellata da pagare al raccoglitore"
    },
    "costo_stoccaggio_t": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per tonnellata da pagare allo stoccaggio"
    },
    "costo_trattamento_t": {
      "type": "number",
      "default": 0,
      "description": "Costo in euro per tonnellata da pagare all'impianto"
    },
    "costo_pulizia": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro"
    },
    "costi_aggiuntivi": {
      "type": "number",
      "default": 0,
      "description": "Importo fisso in euro per oneri non riconducibili alle voci precedenti"
    },
    "note_costi": {
      "type": "string",
      "description": "Spiegazione obbligatoria quando costi_aggiuntivi o costo_pulizia > 0"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id_ordine"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}