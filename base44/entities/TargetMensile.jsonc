{
  "name": "TargetMensile",
  "type": "object",
  "properties": {
    "regione": {
      "type": "string"
    },
    "impianto": {
      "type": "string",
      "description": "Impianto di destinazione a cui e' legato il target (come nel Report Generale): un raccoglitore puo' avere piu' righe, una per impianto"
    },
    "raccoglitore": {
      "type": "string",
      "description": "Trasportatore / raccoglitore"
    },
    "mese": {
      "type": "string"
    },
    "anno": {
      "type": "number"
    },
    "target": {
      "type": "number",
      "description": "Target mensile assegnato al raccoglitore (t). Fonte unica: Target & Status, scheda Target raccoglitori"
    },
    "non_raccoglie": {
      "type": "boolean",
      "default": false,
      "description": "Il raccoglitore non raccoglie in questo mese"
    },
    "storico_json": {
      "type": "string",
      "description": "Modifiche nel tempo: [{ il, da, nota, prima: { target, non_raccoglie } }]"
    },
    "target_annuo": {
      "type": "number",
      "description": "Non piu' usato: il target annuo sta in TargetRaccoglitore"
    },
    "raccolto": {
      "type": "number",
      "description": "Raccolto effettivo del mese (ton) - calcolato"
    },
    "delta": {
      "type": "number",
      "description": "Target mensile - Raccolto (ton)"
    },
    "leftover": {
      "type": "number",
      "description": "Target annuo - Raccolto totale (ton)"
    },
    "total_picked_up": {
      "type": "number"
    },
    "target_upD": {
      "type": "number",
      "description": "Target aggiornato con leftover"
    }
  },
  "required": [
    "regione",
    "raccoglitore",
    "mese"
  ]
}
