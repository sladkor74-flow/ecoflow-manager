{
  "name": "CommessaEcotyre",
  "type": "object",
  "properties": {
    "anno": {
      "type": "number",
      "description": "Anno della commessa: un record per anno"
    },
    "target_annuo_t": {
      "type": "number",
      "description": "Target annuo di raccolta assegnato da Ecotyre (t)"
    },
    "regioni_json": {
      "type": "string",
      "description": "Target del contratto per regione: [{ regione, province, target_t }]"
    },
    "classi_json": {
      "type": "string",
      "description": "Ripartizione del target per classe: [{ classe, descrizione, peso, percentuale }]"
    },
    "target_mensile_iniziale_json": {
      "type": "string",
      "description": "Target mensile iniziale della commessa (t), dodici valori"
    },
    "target_mensile_json": {
      "type": "string",
      "description": "Target mensile rivisto della commessa (t), dodici valori"
    },
    "budget_rete_json": {
      "type": "string",
      "description": "Budget mensile rete in tonnellate, dodici valori da gennaio a dicembre"
    },
    "budget_aci_json": {
      "type": "string",
      "description": "Budget mensile ACI in tonnellate, dodici valori da gennaio a dicembre"
    },
    "destinazioni_json": {
      "type": "string",
      "description": "Quantita' del contratto per destinazione: [{ destinazione, target_t, trattamento }]"
    },
    "target_prezzo_regioni_json": {
      "type": "string",
      "description": "Tabella \"Target Ecotyre\" per regione con prezzo: [{ regione, target_t, prezzo }]"
    },
    "fine_programmazione": {
      "type": "string",
      "format": "date",
      "description": "Fino a quando si programmano le secondarie dell'anno (AAAA-MM-GG), per gli impianti senza una data loro (27/09/2026). Vuoto: il 18/12 per il 2026, il 31/12 con un avviso per gli altri anni (fineProgrammazione.ts)."
    },
    "kg_per_viaggio": {
      "type": "number",
      "description": "Quanto vale un viaggio di secondaria nei conti della predittivita' (kg), per quell'anno (27/09/2026). Vuoto: le regole dell'anno (regolePredittivita.ts), 13.000 kg per il 2026."
    },
    "note": {
      "type": "string"
    },
    "storico_json": {
      "type": "string",
      "description": "Modifiche nel tempo: [{ il, da, nota, prima }]"
    }
  },
  "required": [
    "anno"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
