{
  "name": "Alert",
  "type": "object",
  "properties": {
    "titolo": {
      "type": "string",
      "description": "Titolo sintetico dell'anomalia"
    },
    "descrizione": {
      "type": "string",
      "description": "Dettaglio dell'anomalia riscontrata"
    },
    "severita": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critico"
      ],
      "default": "warning",
      "description": "Livello di gravit\u00e0 dell'alert"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "secondarie",
        "primarie_rete",
        "primarie_aci",
        "terziarie",
        "assegnati",
        "verifiche",
        "giacenze",
        "extra_raccolta"
      ],
      "description": "Modulo in cui \u00e8 stata rilevata l'anomalia. extra_raccolta: le schede di Extra Raccolta, per ora con il solo controllo delle date obbligatorie"
    },
    "entity_type": {
      "type": "string",
      "description": "Tipo entit\u00e0 (Secondaria, PrimariaRete, ecc.)"
    },
    "record_id": {
      "type": "string",
      "description": "ID ordine del record anomalo"
    },
    "regola_id": {
      "type": "string",
      "description": "ID della regola violata"
    },
    "regola_nome": {
      "type": "string",
      "description": "Nome della regola violata"
    },
    "stato": {
      "type": "string",
      "enum": [
        "aperto",
        "risolto",
        "ignorato"
      ],
      "default": "aperto",
      "description": "Stato di gestione dell'alert"
    },
    "risolto_note": {
      "type": "string",
      "description": "Note di risoluzione se risolto/ignorato"
    },
    "canale": {
      "type": "string",
      "description": "Il canale a cui l'alert si riferisce, quando e' uno solo: rete, ACI o extra (extra raccolta); vuoto per le terziarie. Lo scrive il controllo delle date obbligatorie, un alert per modulo e canale: rete, ACI ed extra raccolta non si contano insieme"
    },
    "quanti": {
      "type": "number",
      "description": "Per gli alert che riassumono un elenco (date obbligatorie): quanti ordini terminati ne fanno parte. Il cruscotto lo legge da qui, senza rileggere gli archivi dei movimenti"
    },
    "senza_fine": {
      "type": "number",
      "description": "Date obbligatorie: quanti degli ordini dell'elenco non hanno la data di fine trasporto, e quindi non stanno in nessun periodo finche' la data manca"
    }
  },
  "required": [
    "titolo",
    "modulo",
    "severita"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}