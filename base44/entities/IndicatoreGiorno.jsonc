{
  "name": "IndicatoreGiorno",
  "type": "object",
  // LA FOTOGRAFIA DI UN GIORNO (10/10/2026).
  //
  // Il gestionale sa rispondere benissimo a «com'e' adesso» e non sa rispondere
  // a «com'era a giugno» ne' a «dove sta andando»: ogni numero si ricalcola sul
  // presente e non resta niente. Qui ogni notte si scrive una riga: i numeri del
  // giorno e l'esito del controllo di coerenza.
  //
  // Serve a due cose diverse, e tutt'e due contano:
  // - IL GUARDIANO: la quadratura di impianti e stoccaggi della rete rifatta
  //   ogni notte, con una riga di esito la mattina. Se qualcosa si scosta lo
  //   scopre il gestionale, non il consorzio. Fino all'11/10/2026 qui entravano
  //   i soli impianti: la pagina e la dashboard ne contavano 6 (con Nappi Sud),
  //   il guardiano 5 (revisione del 13/10/2026: i testi dicono chi si guarda).
  // - LO STORICO: una curva di dodici mesi invece di una tabella di oggi. Il suo
  //   valore e' il tempo che accumula, quindi comincia presto anche se i grafici
  //   arrivano dopo.
  //
  // Una riga per giorno: il giorno e' la chiave, e riscrivere lo stesso giorno
  // aggiorna invece di aggiungere (un ricalcolo di mezzogiorno non deve creare
  // una seconda fotografia dello stesso giorno).
  "properties": {
    "giorno": {
      "type": "string",
      "format": "date",
      "description": "Il giorno italiano della fotografia, AAAA-MM-GG. Uno solo per giorno: si riscrive, non si aggiunge"
    },
    "anno": {
      "type": "number",
      "description": "L'anno a cui si riferiscono i numeri"
    },
    "esito": {
      "type": "string",
      "enum": [
        "in_linea",
        "da_guardare"
      ],
      "default": "in_linea",
      "description": "in_linea: ogni impianto e ogni stoccaggio della rete con un confronto a portale quadra. da_guardare: almeno uno si scosta oltre la tolleranza. L'ACI degli stoccaggi resta fuori dal verdetto, come nella dashboard"
    },
    "nota": {
      "type": "string",
      "description": "L'esito in una riga, come si legge la mattina"
    },
    "siti_json": {
      "type": "string",
      "description": "I numeri per sito, in JSON: sito, ruolo, giacenza, portale, scarto, quadra, conferito, dichiarato. Un canale per volta, mai sommati. Per canale anche mesi_aperti [{ mese, provenienza (solo ACI), da_dichiarare_t }], dal piu' vecchio, con «dall'anno prima» in testa: solo i mesi con qualcosa da dichiarare, e la loro somma e' la colonna «Da dichiarare». Il campo manca sulla rete non dovuta e dove il conto mese per mese non c'e': assente non vuol dire «niente da dichiarare», l'elenco vuoto si'"
    },
    "totali_json": {
      "type": "string",
      "description": "I totali del giorno, in JSON: conferito, dichiarato e giacenza per canale. RETE, ACI ed EXTRA_RACCOLTA restano separati"
    },
    "scostamenti_json": {
      "type": "string",
      "description": "Gli impianti e gli stoccaggi della rete che non quadrano, in JSON: sito, scarto e di quanto; uno stoccaggio porta stoccaggio: true. Vuoto quando tutto e' in linea"
    },
    // I DOPPIONI DELLE DICHIARAZIONI (10/10/2026).
    //
    // Due righe sullo stesso sito, canale, provenienza e mese. La piattaforma
    // non ha vincoli di unicita', quindi l'unico presidio e' il codice - e
    // finche' un doppione resta, i numeri dipendono da quale modulo si guarda:
    // il riepilogo ne tiene una sola, le giacenze le sommano. Qui si scrive
    // ogni notte, cosi' uno nato oggi si trova domattina e non a fine anno.
    // L'extra raccolta resta fuori: a portale non e' gestita, sono campagne
    // occasionali e nello stesso mese ce ne possono stare due.
    "doppioni_json": {
      "type": "string",
      "description": "Le dichiarazioni in doppio, in JSON: sito, canale, provenienza, mese, quante e i chili in piu'. Extra raccolta esclusa, dove ripetersi e' legittimo"
    },
    // LE IDENTITA' FRA MODULI (chiusura dell'audit, 11/10/2026).
    //
    // Lo stesso numero chiesto a due moduli che lo devono dire uguale: la giacenza
    // di Giacenze e di Dichiarazioni sito per sito e canale per canale, la riga
    // «Da dichiarare» contro la giacenza del canale, il raccolto di rete in
    // Dashboard, Giacenze e Dichiarazioni, nessun doppione. Lo scrive
    // controllaInvarianti, il passo del guardiano dopo la fotografia; il catalogo
    // sta in shared/invarianti.ts. La fotografia non tocca questo campo.
    "invarianti_json": {
      "type": "string",
      "description": "Le identita' fra moduli controllate stanotte, in JSON: per ogni voce se torna, i due numeri e i due moduli, i casi che non tornano, e quelle che non si sono potute verificare col motivo"
    }
  },
  "required": [
    "giorno"
  ],
  // La scrive solo la funzione notturna, con il ruolo di servizio: la leggono
  // tutti, nessuno la modifica a mano.
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
