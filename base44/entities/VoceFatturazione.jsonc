{
  "name": "VoceFatturazione",
  "type": "object",
  "properties": {
    "documento_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "PASSIVA",
        "ATTIVA"
      ],
      "default": "PASSIVA"
    },
    "tipologia": {
      "type": "string",
      "enum": [
        "RETE",
        "ACI",
        "EXTRA_RACCOLTA"
      ],
      "description": "Tipologia fatturazione attiva"
    },
    "fornitore_id": {
      "type": "string"
    },
    "fornitore_nome": {
      "type": "string"
    },
    "servizio_id": {
      "type": "string"
    },
    "servizio_nome": {
      "type": "string"
    },
    "eer_codice": {
      "type": "string"
    },
    "classe": {
      "type": "string"
    },
    "descrizione": {
      "type": "string"
    },
    "quantita": {
      "type": "number"
    },
    "unita_misura": {
      "type": "string"
    },
    "tariffa_id": {
      "type": "string"
    },
    "tariffa_valore": {
      "type": "number"
    },
    "totale": {
      "type": "number"
    },
    "origine_dato": {
      "type": "string",
      "enum": [
        "PICKERS",
        "PLANTS",
        "SECONDARIE",
        "TERMINATI_RETE",
        "ACI",
        "TERZIARIE",
        "MANUALE"
      ]
    },
    "record_ids": {
      "type": "object",
      "description": "Array di ID record sorgente (max 50)"
    },
    "record_count": {
      "type": "number"
    },
    "anno": {
      "type": "number"
    },
    "mese": {
      "type": "string"
    },
    "stato_validazione": {
      "type": "string",
      "enum": [
        "verificato",
        "da_controllare",
        "errore"
      ],
      "default": "da_controllare"
    },
    "note": {
      "type": "string"
    },
    "regione": {
      "type": "string"
    },
    "fatturante": {
      "type": "string"
    },
    "ticket_n": {
      "type": "string"
    },
    "ordine": {
      "type": "string"
    },
    "data_fine_trasporto": {
      "type": "string",
      "format": "date-time"
    },
    "numero_fir": {
      "type": "string"
    },
    "unita_quantita": {
      "type": "string"
    },
    "unita_prezzo": {
      "type": "string"
    },
    "fattore_conversione": {
      "type": "number"
    },
    "sospesa": {
      "type": "boolean",
      "default": false
    },
    "motivo_sospensione": {
      "type": "string"
    },
    "modifiche": {
      "type": "object",
      "description": "Storico modifiche manuali"
    },
    "origine_record_id": {
      "type": "string"
    }
  },
  "required": [
    "documento_id",
    "quantita",
    "totale"
  ]
}