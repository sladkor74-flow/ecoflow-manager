{
  "name": "GiacenzaSito",
  "type": "object",
  "properties": {
    "sito": {
      "type": "string",
      "description": "Ragione sociale come compare nel campo destinazione dei file del portale"
    },
    "tipo_destinazione": {
      "type": "string",
      "enum": [
        "imp",
        "stoc"
      ],
      "description": "Stesso valore del campo Tipo_Destinazione dei formulari: imp = impianto di trattamento, stoc = stoccaggio. Un soggetto con entrambi i ruoli ha due righe."
    },
    "anno": {
      "type": "number"
    },
    "target_primarie_t": {
      "type": "number",
      "default": 0
    },
    "target_totale_t": {
      "type": "number",
      "default": 0,
      "description": "Comprensivo delle secondarie ricevute; vale zero per gli stoccaggi, che non ne hanno uno"
    },
    "giacenza_riferimento_t": {
      "type": "number",
      "default": 0,
      "description": "Residuo a portale al 31 dicembre dell'anno precedente, a titolo di riferimento storico"
    },
    "dichiara_rete": {
      "type": "boolean",
      "default": true,
      "description": "Falso per gli impianti a cui non paghiamo il trattamento dei PFU di rete e che percio non ci mandano la dichiarazione: i loro conferimenti di rete non ne generano una, e il modulo non la chiede. Vale per Tecnogum, di cui paghiamo e seguiamo solo le dichiarazioni ACI."
    },
    "tipologia_trattamento": {
      "type": "string",
      "enum": [
        "EoW",
        "Frantumazione/R1",
        "n.a."
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "sito",
    "tipo_destinazione",
    "anno"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}