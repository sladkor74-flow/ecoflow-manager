{
  "name": "GiacenzaSito",
  "type": "object",
  "properties": {
    "sito": {
      "type": "string",
      "description": "Ragione sociale come compare nel campo destinazione dei file del portale"
    },
    "tipo_destinazione": {
      "type": "string",
      "enum": [
        "imp",
        "stoc"
      ],
      "description": "Stesso valore del campo Tipo_Destinazione dei formulari: imp = impianto di trattamento, stoc = stoccaggio. Un soggetto con entrambi i ruoli ha due righe."
    },
    "anno": {
      "type": "number"
    },
    "target_primarie_t": {
      "type": "number",
      "default": 0,
      "description": "SUPERATO (27/09/2026): non si scrive piu'. Il target delle primarie del sito e' la somma dei target annui dei raccoglitori di quell'anno legati al sito (TargetRaccoglitore, in Target & Status). Il vecchio valore resta e si usa solo come ripiego di transizione quando i raccoglitori non danno niente"
    },
    "target_totale_t": {
      "type": "number",
      "default": 0,
      "description": "SUPERATO (27/09/2026): non si scrive piu'. Il target totale dell'impianto (comprensivo delle secondarie ricevute) si scrive in Target & Status (ImpiantoTargetSecondaria.target, in kg, per anno) e le Giacenze lo leggono da li'. Il vecchio valore resta e si usa solo come ripiego di transizione, con l'anomalia 'target_da_portare', finche' non e' portato in Target & Status (portaTargetInTargetStatus)"
    },
    "giacenza_riferimento_t": {
      "type": "number",
      "default": 0,
      "description": "Residuo a portale al 31 dicembre dell'anno precedente, a titolo di riferimento storico: e' la giacenza della RETE"
    },
    "giacenza_riferimento_aci_t": {
      "type": "number",
      "default": 0,
      "description": "Residuo ACI al 31 dicembre dell'anno precedente, dove c'e'. Rete e ACI non si sommano mai: ognuno ha la sua giacenza"
    },
    // IL GIORNO DELL'APERTURA (10/10/2026). Le due giacenze di riferimento qui sopra
    // le scrive la chiusura dell'anno prima, dalle letture del 31 dicembre: questo
    // campo dice di che giorno sono. Serve a distinguere uno zero letto (l'impianto
    // era vuoto) da uno zero mai scritto (nessuno ha chiuso l'anno), che hanno lo
    // stesso numero e conseguenze opposte: la lista dell'anno nuovo lo legge.
    "apertura_del": {
      "type": "string",
      "format": "date",
      "description": "Il giorno delle letture da cui vengono le giacenze di riferimento (il 31/12 dell'anno prima), scritto dalla chiusura. Vuoto: l'apertura non e' stata scritta da una chiusura"
    },
    "dichiara_rete": {
      "type": "boolean",
      "default": true,
      "description": "Falso per gli impianti a cui non paghiamo il trattamento dei PFU di rete e che percio non ci mandano la dichiarazione: i loro conferimenti di rete non ne generano una, e il modulo non la chiede. Vale per Tecnogum, di cui paghiamo e seguiamo solo le dichiarazioni ACI."
    },
    "tipologia_trattamento": {
      "type": "string",
      "enum": [
        "EoW",
        "Frantumazione/R1",
        "n.a."
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "sito",
    "tipo_destinazione",
    "anno"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}