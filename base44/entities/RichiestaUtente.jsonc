{
  "name": "RichiestaUtente",
  "type": "object",
  "properties": {
    "titolo": {
      "type": "string",
      "description": "Che cosa si chiede, in poche parole"
    },
    "modulo": {
      "type": "string",
      "description": "Modulo del gestionale a cui si riferisce la richiesta"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "caricamento",
        "correzione",
        "modifica",
        "nuova_funzione",
        "altro"
      ],
      "default": "altro",
      "description": "Genere di intervento chiesto all'amministratore"
    },
    "descrizione": {
      "type": "string",
      "description": "Che cosa serve e perche', con i riferimenti utili: formulario, ID ordine, impianto, periodo"
    },
    "urgenza": {
      "type": "string",
      "enum": [
        "bassa",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Quanto e' urgente secondo chi la invia"
    },
    "stato": {
      "type": "string",
      "enum": [
        "in_attesa",
        "approvata",
        "eseguita",
        "respinta"
      ],
      "default": "in_attesa",
      "description": "Stato della valutazione dell'amministratore"
    },
    "richiedente_nome": {
      "type": "string",
      "description": "Nome di chi ha inviato la richiesta"
    },
    "richiedente_email": {
      "type": "string",
      "description": "Email di chi ha inviato la richiesta, per rispondere"
    },
    "inviata_il": {
      "type": "string",
      "format": "date-time",
      "description": "Momento dell'invio"
    },
    "risposta": {
      "type": "string",
      "description": "Nota dell'amministratore: cosa e' stato fatto o perche' no"
    },
    "decisa_da": {
      "type": "string",
      "description": "Chi ha valutato la richiesta"
    },
    "decisa_il": {
      "type": "string",
      "format": "date-time",
      "description": "Momento della decisione"
    }
  },
  "required": [
    "titolo",
    "descrizione"
  ],
  // APRIRE UNA RICHIESTA E' L'UNICA SCRITTURA DI UN UTENTE NON AMMINISTRATORE.
  //
  // Il 01/10/2026 la scansione della piattaforma ha messo da sola "create": null
  // (commit 35f1b3d). Qui la create e' esattamente la cosa che deve restare
  // aperta: il form di src/pages/Richieste.jsx si disegna SOLO quando l'utente
  // non e' amministratore, l'amministratore non ha nessun pulsante per creare
  // una richiesta, e src/lib/permessi.js tiene RichiestaUtente fra le
  // ENTITA_LIBERE proprio per lasciarla passare. Il gestionale dice a chi non
  // puo' scrivere, in due punti del codice: "per un caricamento o una
  // correzione apri una richiesta dal modulo Richieste". Con la create chiusa
  // quella frase diventa un vicolo chiuso.
  //
  // "null" non e' nessuna delle due cose che servono: e' l'unico null in tutte
  // le entita' e ogni altro divieto qui si scrive user_condition role admin.
  //
  // IL FILTRO IN LETTURA INVECE SI TIENE, perche' correggeva un difetto vero:
  // con read: true il server mandava a ogni utente le richieste di tutti, e il
  // "vedo solo le mie" era soltanto un filtro nel browser. Cambia la chiave:
  // created_by_id lo riempie la piattaforma, mentre richiedente_email lo scrive
  // il browser e ripiega sulla stringa vuota - una chiave di sicurezza non si
  // prende da un campo che il client puo' lasciare vuoto. Via anche il prefisso
  // "data.", che in tutte le entita' compare solo qui: lo stesso commit
  // automatico ha scritto created_by_id nudo su EsercitazioneRT, e le due forme
  // non possono essere giuste entrambe.
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}