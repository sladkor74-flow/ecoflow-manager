{
  "name": "TargetRaccoglitore",
  "type": "object",
  "properties": {
    "raccoglitore": {
      "type": "string",
      "description": "Nome del raccoglitore/trasportatore"
    },
    "regione": {
      "type": "string",
      "description": "Regione per split regionali di raccoglitori multi-regione (es. Smoco in Puglia/Calabria/Basilicata). Null = raccoglitore puro."
    },
    "impianto": {
      "type": "string",
      "description": "Impianto di destinazione a cui e' legato il target (come nel Report Generale): un raccoglitore puo' avere piu' righe, una per impianto"
    },
    "ruolo": {
      "type": "string",
      "enum": ["impianto", "stoccaggio"],
      "description": "Dove arriva il materiale di questa riga quando il sito ha due ruoli: l'impianto o il suo piazzale. Vuoto = impianto, che e' il caso normale. Serve a chi, come T-Cycle, ha un target sul capannone e uno sul piazzale."
    },
    "anno": {
      "type": "number",
      "description": "Anno di riferimento"
    },
    "target_tonnellate": {
      "type": "number",
      "description": "Target annuo assegnato (t), definito a inizio anno o alla contrattualizzazione"
    },
    "attivo_dal": {
      "type": "string",
      "description": "Giorno di inizio del contratto (aaaa-mm-gg), se non da inizio anno"
    },
    "storico_json": {
      "type": "string",
      "description": "Modifiche nel tempo: [{ il, da, nota, prima: { target_tonnellate, attivo_dal } }]"
    }
  },
  "required": [
    "raccoglitore",
    "anno",
    "target_tonnellate"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
