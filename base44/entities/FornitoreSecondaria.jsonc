{
  "name": "FornitoreSecondaria",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "impianto_id": {
      "type": "string",
      "description": "ID impianto target"
    },
    "impianto_nome": {
      "type": "string"
    },
    "ruolo": {
      "type": "string",
      "enum": [
        "raccoglitore",
        "impianto",
        "stoccaggio",
        "doppio_ruolo"
      ],
      "default": "raccoglitore",
      "description": "Ruolo esplicito del soggetto nella filiera: raccoglitore (gommista->primaria), impianto (destinazione finale), stoccaggio (accumulo intermedio), doppio_ruolo (impianto+stoccaggio, es. T-CYCLE)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "stoccaggio",
        "primaria_diretta"
      ],
      "default": "primaria_diretta",
      "description": "DEPRECATO - sostituito da 'ruolo'. Mantenuto per retrocompatibilita'."
    },
    "quota_target": {
      "type": "number",
      "description": "DEPRECATO - non piu usato dalla predittivita. Il target annuo del raccoglitore e' letto da TargetRaccoglitore."
    },
    "plafond_stoccaggio_kg": {
      "type": "number",
      "description": "Plafond totale conferibile allo stoccaggio (kg) - significativo solo per ruolo=stoccaggio o doppio_ruolo. Include contributi di tutti i conferitori, non solo il raccoglitore stesso."
    },
    "regione": {
      "type": "string",
      "description": "Regione di pertinenza dello stoccaggio (auto-derivata dalle secondarie, sola lettura)"
    },
    "ipotesi_mese_corrente": {
      "type": "number",
      "default": 0,
      "description": "Ipotesi di raccolta del mese in corso non ancora consuntivata (kg)"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "anno": {
      "type": "number",
      "description": "Anno della predittivita' a cui vale il record (26/09/2026): ogni anno ha i suoi impianti, stoccaggi e fornitori, copiati dall'anno prima e confermati. Un record senza anno vale per il 2026, l'anno in cui la predittivita' e' nata."
    },
    "priorita": {
      "type": "number",
      "description": "Per uno stoccaggio che alimenta piu' impianti: l'ordine dell'impianto (1 = il primo). Non vuol dire servirlo prima degli altri: ogni settimana lo stoccaggio li serve tutti, e al primo va il numero di viaggi che gli fa raggiungere il target entro la fine della programmazione, agli altri quello che resta. Vuoto: le regole dell'anno (regolePredittivita.ts), poi pari."
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "impianto_id"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}