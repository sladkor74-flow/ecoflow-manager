{
  "name": "FornitoreSecondaria",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "impianto_id": {
      "type": "string",
      "description": "ID impianto target"
    },
    "impianto_nome": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "stoccaggio",
        "primaria_diretta"
      ],
      "default": "primaria_diretta",
      "description": "stoccaggio = raccoglie allo stoccaggio proprio poi invia secondarie (es. Nappi Sud); primaria_diretta = consegna direttamente in primaria all'impianto"
    },
    "quota_target": {
      "type": "number",
      "description": "Quota target del fornitore (kg)"
    },
    "ipotesi_mese_corrente": {
      "type": "number",
      "default": 0,
      "description": "Ipotesi di raccolta del mese in corso non ancora consuntivata (kg)"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "impianto_id"
  ]
}