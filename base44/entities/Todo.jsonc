{
  "name": "Todo",
  "type": "object",
  "properties": {
    "titolo": {
      "type": "string"
    },
    "descrizione": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "description": "es. Comunicazione consorzio, Sollecito, Pratica"
    },
    "priorita": {
      "type": "string",
      "enum": [
        "bassa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "stato": {
      "type": "string",
      "enum": [
        "aperto",
        "in_corso",
        "completato",
        "cancellato"
      ],
      "default": "aperto",
      "description": "cancellato lo scrive solo il controllo degli ordini, quando il portale da tutti gli ordini dell attivita cancellati: va fra i Cancellati della pagina e non conta fra le cose da fare"
    },
    "data_ricezione": {
      "type": "string",
      "format": "date"
    },
    "data_scadenza": {
      "type": "string",
      "format": "date"
    },
    "data_sollecito": {
      "type": "string",
      "format": "date",
      "description": "Data alert sollecito"
    },
    "mittente": {
      "type": "string"
    },
    "riferimento_ordine": {
      "type": "string",
      "description": "Uno o piu ID ordine Ecotyre da completare, separati da virgola: quando risultano tutti terminati (fine trasporto) il gestionale chiude l attivita da solo; se il portale li da tutti cancellati la passa fra le cancellate (stato cancellato), con alcuni terminati e gli altri cancellati la chiude evasa in parte; in tutti i casi solo se ha visto gli ordini aperti"
    },
    "ordini_totali": {
      "type": "number",
      "default": 0,
      "description": "Quanti ID ordine sono scritti sull attivita"
    },
    "ordini_attesi": {
      "type": "string",
      "description": "Gli ID ordine che il gestionale sta guardando su questa attivita. Se cambiano si ricomincia a guardare, e quel giro non chiude niente"
    },
    "ordini_da_attendere": {
      "type": "string",
      "description": "Gli ordini che risultavano ancora aperti quando il gestionale ha cominciato a guardare: l attivita si chiude solo quando questi passano a terminato, cosi il passaggio si vede davvero. Vuoto vuol dire che non c e nessun passaggio da attendere, e la spunta la mette chi lavora"
    },
    "ordini_terminati": {
      "type": "number",
      "default": 0,
      "description": "Quanti di quegli ordini risultano terminati con la fine trasporto: l attivita si chiude quando lo sono tutti"
    },
    "chiusa_dal_gestionale": {
      "type": "boolean",
      "default": false,
      "description": "Vero quando l ha chiusa il controllo degli ordini, non una spunta a mano. Riaperta a mano resta vero, cosi il gestionale non la richiude"
    },
    "chiusa_dal_gestionale_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui il gestionale l ha chiusa; per una cancellata e il giorno in cui il gestionale l ha trovata cancellata: il portale non scrive quello della cancellazione"
    },
    "completata_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno italiano in cui l amministratore ha segnato a mano l attivita come completata (spunta o targhetta dello stato): lo scrive la pagina To-Do List e si toglie (null) quando la si riapre. Le chiusure del gestionale hanno il loro giorno in chiusa_dal_gestionale_il"
    },
    "chiusura_nota": {
      "type": "string",
      "description": "Perche e quando si e chiusa: chiusa dal gestionale il GG/MM/AAAA, l ordine ET... risulta terminato; oppure cancellata dal gestionale il GG/MM/AAAA, l ordine ET... (motivo) risulta cancellato a portale"
    },
    "avviso_ordini": {
      "type": "string",
      "description": "Perche l attivita resta aperta anche se un suo ordine non e in corso: ordine eseguito a portale senza il clic su Chiudi, terminato senza la data di fine trasporto, ID che non si trova, ordine gia cancellato quando l attivita e stata scritta (il gestionale non ha visto il passaggio). Su un attivita gia chiusa dice che cosa guardare, per esempio un ordine che il portale ha riassegnato"
    }
  },
  "required": [
    "titolo"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}