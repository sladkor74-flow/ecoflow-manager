{
  "name": "CodiceEer",
  "type": "object",
  "properties": {
    "codice": {
      "type": "string"
    },
    "descrizione": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    }
  },
  "required": [
    "codice"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}