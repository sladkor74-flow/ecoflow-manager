{
  "name": "PianificazioneSettimanale",
  "type": "object",
  "properties": {
    "impianto_id": {
      "type": "string"
    },
    "impianto_nome": {
      "type": "string"
    },
    "fornitore_id": {
      "type": "string"
    },
    "fornitore_nome": {
      "type": "string"
    },
    "settimana_numero": {
      "type": "number"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date"
    },
    "kg_previsti": {
      "type": "number"
    },
    "kg_effettivi": {
      "type": "number"
    },
    "viaggi_previsti": {
      "type": "number"
    },
    "viaggi_effettivi": {
      "type": "number"
    },
    "stato": {
      "type": "string",
      "enum": [
        "da_programmare",
        "programmatato",
        "programmato",
        "completato",
        "annullato"
      ],
      "default": "da_programmare"
    },
    "anno": {
      "type": "number"
    },
    "modificato_manuale": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string"
    },
    "origine": {
      "type": "string",
      "enum": ["programma", "manuale"],
      "description": "Da dove viene la riga (26/09/2026): 'programma' = fissata dal suggerimento del mercoledi' (i viaggi della settimana dopo, stoccaggio per impianto), 'manuale' = corretta a mano dall'amministratore, che il suggerimento non sovrascrive piu'. Le righe senza origine sono del piano di prima e non si leggono piu'."
    }
  },
  "required": [
    "impianto_id",
    "settimana_numero",
    "data_inizio"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}