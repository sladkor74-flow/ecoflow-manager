{
  "name": "Tariffa",
  "type": "object",
  "properties": {
    "fornitore_id": {
      "type": "string"
    },
    "fornitore_nome": {
      "type": "string"
    },
    "servizio_id": {
      "type": "string"
    },
    "servizio_nome": {
      "type": "string"
    },
    "prestazione": {
      "type": "string",
      "enum": [
        "RACCOLTA",
        "TRASPORTO_SECONDARIA",
        "TRATTAMENTO",
        "CONFERIMENTO_STOCCAGGIO"
      ],
      "description": "Prestazione fatturata: RACCOLTA (raccoglitore), TRASPORTO_SECONDARIA (trasportatore secondarie), TRATTAMENTO (impianto triturazione), CONFERIMENTO_STOCCAGGIO (stoccaggio)"
    },
    "destinazione": {
      "type": "string",
      "description": "Solo RACCOLTA: la tariffa vale unicamente per i conferimenti con questa destinazione"
    },
    "produttore": {
      "type": "string",
      "description": "Solo TRASPORTO_SECONDARIA: produttore della tratta"
    },
    "destinatario": {
      "type": "string",
      "description": "Solo TRASPORTO_SECONDARIA: destinatario della tratta"
    },
    "classe_materiale": {
      "type": "string",
      "description": "P, M, G1, G2 o vuoto per tutte le classi"
    },
    "eer_codice": {
      "type": "string",
      "description": "Codice EER specifico o vuoto per tutti"
    },
    "unita_misura": {
      "type": "string",
      "enum": [
        "\u20ac/t",
        "\u20ac/kg",
        "\u20ac/viaggio",
        "\u20ac/mese"
      ]
    },
    "valore": {
      "type": "number"
    },
    "data_inizio_validita": {
      "type": "string",
      "format": "date"
    },
    "data_fine_validita": {
      "type": "string",
      "format": "date"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "note": {
      "type": "string"
    },
    "direzione": {
      "type": "string",
      "enum": [
        "PASSIVA",
        "ATTIVA"
      ],
      "default": "PASSIVA"
    },
    "tipologia": {
      "type": "string",
      "enum": [
        "RETE",
        "ACI",
        "EXTRA_RACCOLTA",
        "TUTTE"
      ],
      "description": "Tipologia fatturazione. TUTTE vale per entrambi i canali RETE+ACI, ammessa solo per TRASPORTO_SECONDARIA"
    },
    "cliente": {
      "type": "string",
      "description": "Cliente/fatturante per fatturazione attiva"
    },
    "regione": {
      "type": "string",
      "description": "Regione per tariffe specifiche (attiva)"
    },
    "provincia": {
      "type": "string",
      "description": "Sigla provincia specifica; vuoto = vale per tutta la regione"
    }
  },
  "required": [
    "unita_misura",
    "valore",
    "prestazione"
  ]
}