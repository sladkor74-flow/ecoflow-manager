{
  "name": "UploadLog",
  "type": "object",
  "properties": {
    "tipo_file": {
      "type": "string",
      "enum": [
        "assegnati",
        "primarie_rete",
        "primarie_aci",
        "primarie",
        "secondarie",
        "terziarie",
        "extra_raccolta",
        "gommisti",
        "pdr",
        "dichiarazioni",
        "fatturazione",
        "status"
      ],
      "description": "Tipologia di file caricato"
    },
    "nome_file": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "righe_importate": {
      "type": "number"
    },
    "righe_fallite": {
      "type": "number"
    },
    "esito": {
      "type": "string",
      "enum": [
        "successo",
        "parziale",
        "errore"
      ]
    },
    "messaggio": {
      "type": "string"
    },
    "periodo_riferimento": {
      "type": "string",
      "description": "Mese/periodo coperto dal file"
    },
    "foglio_usato": {
      "type": "string",
      "description": "Nome del foglio Excel riconosciuto tramite firma intestazioni"
    },
    "righe_archivio_prima": {
      "type": "number",
      "description": "Numero di record gia' presenti in archivio prima dell'import (controllo anti-regressione)"
    },
    "forzato": {
      "type": "boolean",
      "description": "Se true l'import e' stato forzato nonostante il controllo anti-regressione"
    }
  },
  "required": [
    "tipo_file",
    "nome_file"
  ]
}