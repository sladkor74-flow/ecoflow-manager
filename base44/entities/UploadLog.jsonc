{
  "name": "UploadLog",
  "type": "object",
  "properties": {
    "tipo_file": {
      "type": "string",
      "enum": [
        "assegnati",
        "primarie_rete",
        "primarie_aci",
        "primarie",
        "secondarie",
        "terziarie",
        "extra_raccolta",
        "gommisti",
        "pdr",
        "dichiarazioni",
        "dichiarazioni_trattamento",
        "ordini_non_dichiarati",
        "fatturazione",
        "status"
      ],
      "description": "Tipologia di file caricato"
    },
    "nome_file": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "righe_importate": {
      "type": "number"
    },
    "righe_fallite": {
      "type": "number"
    },
    "esito": {
      "type": "string",
      "enum": [
        "successo",
        "parziale",
        "errore",
        "in_corso"
      ],
      "description": "in_corso: l'archivio e' stato svuotato e la scrittura non e' ancora finita. Se resta cosi', il caricamento si e' interrotto e l'archivio puo' essere incompleto"
    },
    "utente": {
      "type": "string",
      "description": "Chi ha fatto il caricamento"
    },
    "messaggio": {
      "type": "string"
    },
    "periodo_riferimento": {
      "type": "string",
      "description": "Mese/periodo coperto dal file"
    },
    "foglio_usato": {
      "type": "string",
      "description": "Nome del foglio Excel riconosciuto tramite firma intestazioni"
    },
    "righe_archivio_prima": {
      "type": "number",
      "description": "Numero di record gia' presenti in archivio prima dell'import (controllo anti-regressione)"
    },
    "forzato": {
      "type": "boolean",
      "description": "Se true l'import e' stato forzato nonostante il controllo anti-regressione"
    },
    "modalita": {
      "type": "string",
      "enum": [
        "sostituzione",
        "aggiunta"
      ],
      "description": "Modalita' di import: sostituzione integrale o aggiunta additiva"
    }
  },
  "required": [
    "tipo_file",
    "nome_file"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}