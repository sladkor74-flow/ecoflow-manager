{
  "name": "ContrattoFornitore",
  "type": "object",
  "properties": {
    "anno": {
      "type": "number"
    },
    "soggetto_chiave": {
      "type": "string",
      "description": "Ragione sociale normalizzata, la stessa chiave dei documenti di qualifica"
    },
    "soggetto_nome": {
      "type": "string"
    },
    "tipo_contratto": {
      "type": "string",
      "enum": [
        "raccolta",
        "stoccaggio",
        "trattamento",
        "trasporto_secondaria"
      ]
    },
    "canale": {
      "type": "string",
      "enum": [
        "RETE",
        "ACI",
        "EXTRA_RACCOLTA"
      ],
      "default": "RETE"
    },
    "modello_id": {
      "type": "string"
    },
    "modello_nome": {
      "type": "string"
    },
    "contratto_precedente_id": {
      "type": "string",
      "description": "Il contratto dell'anno prima da cui sono stati ripresi i valori"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date"
    },
    "quantitativo_previsto_t": {
      "type": "number",
      "description": "Quantitativo previsto per l'anno, in tonnellate"
    },
    "condizioni_pagamento": {
      "type": "string",
      "description": "Condizioni economiche di pagamento, come vanno scritte nel contratto"
    },
    "valori_json": {
      "type": "string",
      "description": "Tutti i valori dei segnaposto del modello: e' quello che serve per rigenerare il documento identico"
    },
    "importi_json": {
      "type": "string",
      "description": "Le righe delle condizioni economiche: voce, importo, unita' di misura"
    },
    "stato": {
      "type": "string",
      "enum": [
        "bozza",
        "generato",
        "inviato",
        "controfirmato",
        "annullato"
      ],
      "default": "bozza"
    },
    "file_uri": {
      "type": "string",
      "description": "Il documento generato"
    },
    "file_nome": {
      "type": "string"
    },
    "generato_il": {
      "type": "string",
      "format": "date-time"
    },
    "inviato_il": {
      "type": "string",
      "format": "date"
    },
    "controfirmato_il": {
      "type": "string",
      "format": "date"
    },
    "documento_qualifica_id": {
      "type": "string",
      "description": "Il documento di qualifica creato quando si carica il contratto controfirmato"
    },
    "documento_firmato": {
      "type": "boolean",
      "default": false,
      "description": "Il file del contratto e' la copia controfirmata caricata dall'amministratore, non il documento generato (12/10/2026)"
    },
    "versioni_json": {
      "type": "string",
      "description": "Le versioni sostituite, la piu' vecchia per prima: [{ file_uri, file_nome, stato, documento_firmato, generato_il, inviato_il, controfirmato_il, valori_json, modello_nome, sostituito_il, motivo }]. Rigenerare un contratto inviato o controfirmato non cancella la versione di prima (12/10/2026)"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "anno",
    "soggetto_chiave",
    "tipo_contratto"
  ],
  "rls": {
    // LA LETTURA E' DELL'AMMINISTRATORE (decisione del 13/10/2026).
    //
    // Un contratto porta i prezzi dei fornitori (valori_json e importi_json: i
    // corrispettivi, cioe' i costi di SMOCO) e i riferimenti ai file del
    // contratto generato, di quello controfirmato e delle versioni sostituite
    // (file_uri, versioni_json). Un file_uri e' la chiave del documento per
    // qualunque utente collegato (vedi DocumentoQualifica). Con "read": true li
    // leggeva chiunque, mentre la pagina li mostra al solo amministratore.
    //
    // Chi non e' amministratore non perde niente a video: la scheda Contratti
    // legge la funzione contrattiAnno, che gira con asServiceRole e gli manda la
    // situazione senza valori e senza file; generare e caricare il firmato
    // passano da salvaContrattoFornitore, solo amministratore; il file si apre da
    // apriFile. Le altre funzioni che li leggono (EcoTyna, il cruscotto, Prepara
    // l'anno, gestisciAnagrafiche) leggono con asServiceRole. Nessuna pagina li
    // legge dal browser: le sole scritture dirette (segna inviato, segna
    // controfirmato) sono dell'amministratore. Prova: prove/chiLeggeCosa.mjs.
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
