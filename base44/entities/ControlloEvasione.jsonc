{
  "name": "ControlloEvasione",
  "type": "object",
  "properties": {
    "lista_id": {
      "type": "string"
    },
    "raccoglitore_chiave": {
      "type": "string"
    },
    "raccoglitore_nome": {
      "type": "string"
    },
    "anno": {
      "type": "number"
    },
    "mese": {
      "type": "number"
    },
    "eseguito_il": {
      "type": "string",
      "format": "date-time"
    },
    "primarie_caricate_il": {
      "type": "string",
      "format": "date-time",
      "description": "Caricamento delle primarie su cui e' stato fatto il controllo"
    },
    "dati_al": {
      "type": "string",
      "format": "date",
      "description": "Ultima data di fine trasporto presente nelle primarie caricate"
    },
    "richieste": {
      "type": "number"
    },
    "evase": {
      "type": "number"
    },
    "evase_da_altri": {
      "type": "number"
    },
    "aperte": {
      "type": "number"
    },
    "prioritarie_aperte": {
      "type": "number"
    },
    "arretrate_aperte": {
      "type": "number",
      "description": "Richieste aperte immesse negli anni precedenti, con priorita' assoluta"
    },
    "fuori_ordine": {
      "type": "number"
    },
    "trascurate": {
      "type": "number",
      "description": "Richieste aperte scavalcate da richieste successive o da ordini fuori lista"
    },
    "fuori_lista": {
      "type": "number"
    },
    "non_piu_presenti": {
      "type": "number"
    },
    "annullate": {
      "type": "number",
      "description": "Richieste della lista cancellate sul portale"
    },
    "riassegnate": {
      "type": "number"
    },
    "raccolto_kg": {
      "type": "number"
    },
    "target_kg": {
      "type": "number"
    },
    "proiezione_kg": {
      "type": "number"
    },
    "evadibili_ritmo": {
      "type": "number"
    },
    "evadibili_target": {
      "type": "number"
    },
    "alert_alti": {
      "type": "number"
    },
    "alert_totali": {
      "type": "number"
    },
    "alert_json": {
      "type": "string"
    },
    "esito_json": {
      "type": "string",
      "description": "Stato di ogni richiesta, ordini evasi fuori lista, previsione e storia del raccoglitore. Si toglie quando il controllo e' superato da uno piu' recente sulla stessa lista, o quando il mese e' chiuso da abbastanza tempo: restano i venti contatori e la storia scritta"
    },
    "storia": {
      "type": "string",
      "description": "La storia scritta del documento, in italiano: resta per sempre. Si scrive quando il dettaglio viene tolto, al quarantesimo giorno dal caricamento (base44/shared/conservazione.ts). E' un campo normale e non passa mai da valoreCampo: se sfondasse gli ottomila caratteri tornerebbe in ContenutoEsteso, cioe' il peso che si e' appena tolto"
    },
    "alleggerito_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui sono stati tolti le righe lette e il confronto riga per riga. Finche' e' vuoto il documento ha ancora tutto il suo dettaglio"
    }
  },
  "required": [
    "lista_id",
    "raccoglitore_chiave",
    "anno",
    "mese"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
