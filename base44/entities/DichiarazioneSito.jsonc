{
  "name": "DichiarazioneSito",
  "type": "object",
  "properties": {
    "sito": {
      "type": "string"
    },
    "operazione": {
      "type": "string",
      "enum": [
        "R3",
        "R1"
      ],
      "description": "R3 = riciclaggio che produce granulo o materia prima secondaria (end of waste) che esce come prodotto con documento di trasporto; R1 = utilizzo come combustibile, tipico degli impianti di frantumazione"
    },
    "canale": {
      "type": "string",
      "enum": [
        "RETE",
        "ACI",
        "EXTRA_RACCOLTA"
      ]
    },
    "provenienza": {
      "type": "string",
      "enum": [
        "primaria",
        "secondaria",
        ""
      ],
      "description": "Si specifica solo per il canale ACI, dove le dichiarazioni sono distinte per provenienza"
    },
    "anno": {
      "type": "number"
    },
    "mese": {
      "type": "string",
      "description": "Nome italiano del mese"
    },
    "quantita_kg": {
      "type": "number",
      "default": 0
    },
    "caricata_inviata": {
      "type": "boolean",
      "default": false,
      "description": "Vero quando la dichiarazione e' stata effettivamente caricata e inviata a portale. Solo i mesi con questo flag true concorrono a decurtare la giacenza."
    },
    "caricata_il": {
      "type": "string",
      "format": "date"
    },
    "ricevuta_email": {
      "type": "boolean",
      "default": false,
      "description": "Vero quando la dichiarazione dell'impianto e' arrivata via email; per Irigom, quando l'abbiamo prodotta noi"
    },
    "ricevuta_il": {
      "type": "string",
      "format": "date"
    },
    "granulo_kg": {
      "type": "number",
      "default": 0,
      "description": "R3: granulo di gomma ricavato (EER 19.12.04)"
    },
    "fibre_kg": {
      "type": "number",
      "default": 0,
      "description": "R3: fibre tessili separate (EER 19.12.08)"
    },
    "metalli_kg": {
      "type": "number",
      "default": 0,
      "description": "Metalli ferrosi separati (EER 19.12.02)"
    },
    "ciabattato_kg": {
      "type": "number",
      "default": 0,
      "description": "R1: ciabattato prodotto (EER 19.12.04)"
    },
    "cippato_kg": {
      "type": "number",
      "default": 0,
      "description": "R1: cippato prodotto (EER 19.12.04)"
    },
    "cssc_kg": {
      "type": "number",
      "default": 0,
      "description": "R1: CSS-C prodotto con cessazione della qualifica di rifiuto"
    },
    "altro_kg": {
      "type": "number",
      "default": 0,
      "description": "Quantita' ricavate che non rientrano nelle voci precedenti"
    },
    "motivo_assenza": {
      "type": "string",
      "enum": [
        "",
        "non_dovuta",
        "solo_metalli"
      ],
      "default": "",
      "description": "Perche' un mese non ha dichiarazione ed e' a posto lo stesso. non_dovuta: il trattamento di quel canale non e' a nostro carico, l'impianto non ci deve la dichiarazione (la rete di Tecnogum). solo_metalli: dall'impianto sono usciti solo metalli ferrosi e nessuna gomma, a portale non si carica nulla e il ferro si dichiara con la prossima uscita di gomma (Irigom, rete di aprile 2026). Vale solo con quantita_kg a zero."
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "sito",
    "anno",
    "mese"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}