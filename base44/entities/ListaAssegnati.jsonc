{
  "name": "ListaAssegnati",
  "type": "object",
  "properties": {
    "raccoglitore_chiave": {
      "type": "string",
      "description": "Ragione sociale normalizzata del raccoglitore, la stessa chiave usata nelle primarie"
    },
    "raccoglitore_nome": {
      "type": "string"
    },
    "anno": {
      "type": "number"
    },
    "mese": {
      "type": "number",
      "description": "Mese di riferimento, da 1 a 12"
    },
    "file_nomi": {
      "type": "string",
      "description": "Nomi dei file che compongono la lista, separati da virgola"
    },
    "caricata_il": {
      "type": "string",
      "format": "date-time"
    },
    "inviata_il": {
      "type": "string",
      "description": "Giorno di invio della lista al raccoglitore (aaaa-mm-gg): da qui partono cronologia, priorita' e trascurate"
    },
    "righe_json": {
      "type": "string",
      "description": "Richieste della lista nell'ordine di evasione, completate con i dati del gestionale al momento del caricamento. Si tolgono quando il mese e' chiuso da abbastanza tempo: la lista non si cancella piu', resta con la sua storia scritta"
    },
    "avvisi_json": {
      "type": "string",
      "description": "Avvisi emersi nella lettura dei file"
    },
    "richieste": {
      "type": "number"
    },
    "prioritarie": {
      "type": "number"
    },
    "storia": {
      "type": "string",
      "description": "La storia scritta del documento, in italiano: resta per sempre. Si scrive quando il dettaglio viene tolto, al quarantesimo giorno dal caricamento (base44/shared/conservazione.ts). E' un campo normale e non passa mai da valoreCampo: se sfondasse gli ottomila caratteri tornerebbe in ContenutoEsteso, cioe' il peso che si e' appena tolto"
    },
    "alleggerito_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui sono stati tolti le righe lette e il confronto riga per riga. Finche' e' vuoto il documento ha ancora tutto il suo dettaglio"
    }
  },
  "required": [
    "raccoglitore_chiave",
    "anno",
    "mese"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
