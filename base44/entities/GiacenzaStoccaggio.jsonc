{
  "name": "GiacenzaStoccaggio",
  "type": "object",
  "properties": {
    "sito": {
      "type": "string",
      "description": "Ragione sociale dello stoccaggio come compare nel campo destinazione dei file del portale"
    },
    "id_unita_stoccaggio": {
      "type": "number",
      "description": "Identificativo dell'unita' locale assegnato dal portale"
    },
    "descrizione_unita": {
      "type": "string",
      "description": "Descrizione dell'unita' come riportata dal portale, ad esempio Stoc/NAPPI SUD SRL"
    },
    "comune": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "data_rilevazione": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui il dato e' stato letto dal portale"
    },
    "class1_kg": {
      "type": "number",
      "default": 0,
      "description": "P, fino a 35 kg, auto e moto"
    },
    "class2_kg": {
      "type": "number",
      "default": 0,
      "description": "M, fino a 155 kg, camion e bus"
    },
    "class3_kg": {
      "type": "number",
      "default": 0,
      "description": "G1, superiori a 155 kg, agricoltura"
    },
    "class4_kg": {
      "type": "number",
      "default": 0,
      "description": "G2, superiori a 155 kg, industriali"
    },
    "class9_kg": {
      "type": "number",
      "default": 0,
      "description": "PFU Autodemolizione, canale ACI"
    },
    // LA FOTOGRAFIA DELLA CHIUSURA DELL'ANNO (15/10/2026, prova generale del
    // cambio d'anno, difetto 5). La rilevazione del 31/12 salvata dalla chiusura
    // porta l'istante del salvataggio e i movimenti dell'elenco di dicembre che la
    // chiusura ha gia' visto: i carichi finiti a dicembre e chiusi a portale dopo,
    // che quella sera il gestionale non aveva, si aggiungono leggendo
    // (letturaDellaChiusura in shared/giacenzaStoccaggi.ts). Una rilevazione
    // scritta a mano non ha questi campi, e resta com'e'.
    "chiusura_salvata_il": {
      "type": "string",
      "format": "date-time",
      "description": "L'istante in cui la chiusura dell'anno ha salvato questa fotografia. Vuoto: una rilevazione scritta a mano"
    },
    "chiusura_rettificate_json": {
      "type": "string",
      "description": "JSON scritto dalla chiusura: { fotografia_del, voci }. Il giorno della lettura del portale e i movimenti dell'elenco di dicembre gia' rettificati o decisi"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "sito",
    "data_rilevazione"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}