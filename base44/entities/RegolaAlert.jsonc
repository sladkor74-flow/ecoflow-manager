{
  "name": "RegolaAlert",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome identificativo della regola"
    },
    "descrizione": {
      "type": "string",
      "description": "Descrizione della regola di validazione"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "secondarie",
        "primarie_rete",
        "primarie_aci",
        "terziarie",
        "assegnati",
        "extra_raccolta"
      ],
      "description": "Modulo su cui si applica la regola. Il motore controlla sempre, in ogni modulo di movimenti e senza bisogno di una regola qui, i conferimenti fuori rotta e gli ordini terminati con date obbligatorie mancanti o incoerenti (immissione, inizio e fine trasporto, regola del 22/09/2026): non si configurano e non si spengono"
    },
    "tipo_regola": {
      "type": "string",
      "enum": [
        "tratta_autorizzata",
        "tratta_combinazione",
        "tratte_autorizzate_classe",
        "province_inattive",
        "mix_classi_deviazione",
        "scostamento_target",
        "ritardo_sla",
        "anomalia_peso"
      ],
      "description": "Tipologia di regola: solo i tipi che il motore (runAlertEngine) valuta davvero. Fino all'11/10/2026 c'erano anche campo_obbligatorio, range_valori, sla_tempi, peso_congruenza e custom, che non producevano mai niente, e mancava tratta_combinazione, che il motore valuta. Il menu della pagina Alert Engine ha gli stessi tipi (prove/regoleAlert.mjs)"
    },
    "severita": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critico"
      ],
      "default": "warning"
    },
    "config": {
      "type": "object",
      "description": "Configurazione regola (JSON): es. {origine: 'NAPPI SUD SRL', destinazioni_ammesse: ['TECNOGUM','IRIGOM S.R.L.']}"
    },
    "attiva": {
      "type": "boolean",
      "default": true,
      "description": "Se la regola \u00e8 attiva"
    },
    "messaggio_alert": {
      "type": "string",
      "description": "Messaggio mostrato nell'alert quando la regola \u00e8 violata"
    },
    "configurata_il": {
      "type": "string",
      "format": "date",
      "description": "Il giorno italiano dell'ultima modifica della configurazione (modulo, tipo, destinazioni, combinazioni, classi, soglie). Lo scrive la pagina Alert Engine quando crea la regola; attivare e disattivare non lo cambiano (decisioni dell'utente del 13/10/2026). Il motore lo usa per sapere se una regola di tratta era gia' quella dell'anno prima: sull'anno prima vale solo una regola configurata prima del 01/01 (base44/shared/configurazioneRegolaAlert.ts)"
    },
    "impronta_configurazione": {
      "type": "string",
      "description": "L'impronta della configurazione del giorno configurata_il (modulo, tipo e config, con le chiavi in ordine). Se la configurazione cambia senza passare dalla pagina l'impronta non torna, e il motore ripiega sulle date di sistema (created_date, updated_date), come per le regole senza configurata_il"
    }
  },
  "required": [
    "nome",
    "modulo",
    "tipo_regola",
    "severita"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}