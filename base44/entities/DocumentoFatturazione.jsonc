{
  "name": "DocumentoFatturazione",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "PASSIVA",
        "ATTIVA"
      ],
      "default": "PASSIVA"
    },
    "tipologia": {
      "type": "string",
      "enum": [
        "RETE",
        "ACI",
        "EXTRA_RACCOLTA"
      ],
      "description": "Tipologia fatturazione attiva"
    },
    "anno": {
      "type": "number"
    },
    "mese": {
      "type": "string"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date"
    },
    "stato": {
      "type": "string",
      "enum": [
        "bozza",
        "elaborata",
        "verificata",
        "approvata",
        "esportata",
        "chiusa"
      ],
      "default": "bozza"
    },
    "cliente": {
      "type": "string",
      "description": "Cliente/fatturante (fatturazione attiva)"
    },
    "totale": {
      "type": "number"
    },
    "numero_fornitori": {
      "type": "number"
    },
    "numero_voci": {
      "type": "number"
    },
    "voci_errore": {
      "type": "number"
    },
    "voci_sospese": {
      "type": "number"
    },
    "data_elaborazione": {
      "type": "string",
      "format": "date-time"
    },
    "data_verifica": {
      "type": "string",
      "format": "date-time"
    },
    "data_approvazione": {
      "type": "string",
      "format": "date-time"
    },
    "data_esportazione": {
      "type": "string",
      "format": "date-time"
    },
    "data_chiusura": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "superato": {
      "type": "boolean",
      "default": false,
      "description": "Documento prodotto da un calcolo non piu' in uso: resta nello storico ma non fa testo"
    },
    "motivo_superato": {
      "type": "string",
      "description": "Perche' il documento e' superato: si scrive sempre, cosi' fra un anno si capisce"
    },
    "fattura_confermata_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui l'amministrazione ha confermato che la fattura al cliente e' stata emessa ed e' andata a buon fine. Un periodo si chiude solo con questa conferma"
    },
    "fattura_numero": {
      "type": "string",
      "description": "Numero o riferimento della fattura emessa, se comunicato dall'amministrazione"
    },
    "fattura_confermata_da": {
      "type": "string",
      "description": "Chi ha registrato la conferma nel gestionale"
    }
  },
  "required": [
    "tipo",
    "anno",
    "mese"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}