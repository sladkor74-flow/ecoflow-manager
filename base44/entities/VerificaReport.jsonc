{
  "name": "VerificaReport",
  "type": "object",
  "properties": {
    "soggetto_chiave": {
      "type": "string",
      "description": "Ragione sociale normalizzata dell'impianto o dello stoccaggio che ha inviato il report"
    },
    "soggetto_nome": {
      "type": "string"
    },
    "anno": {
      "type": "number",
      "description": "Anno della settimana secondo la numerazione ISO"
    },
    "settimana": {
      "type": "number"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date"
    },
    "file_nome": {
      "type": "string"
    },
    "nota": {
      "type": "string",
      "description": "Per una dichiarazione di nessuna movimentazione: riferimento della comunicazione dell'impianto (email, data, mittente)"
    },
    "file_tipo": {
      "type": "string",
      "enum": [
        "excel",
        "csv",
        "pdf",
        "immagine",
        "dichiarazione"
      ],
      "description": "Il file non viene conservato: se ne salvano solo i dati letti, cosi' alla cancellazione non resta nulla in archivio"
    },
    "stato": {
      "type": "string",
      "enum": [
        "in_lettura",
        "in_verifica",
        "completata",
        "errore"
      ],
      "default": "in_lettura"
    },
    "avviata_il": {
      "type": "string",
      "format": "date-time"
    },
    "errore": {
      "type": "string"
    },
    "lettura_json": {
      "type": "string",
      "description": "Come e' stato letto il file: foglio, colonne riconosciute, unita' di misura, note dell'agente"
    },
    "righe_report_json": {
      "type": "string",
      "description": "Righe del report gia' normalizzate: servono a ripetere la verifica senza rileggere il file. Si tolgono al quarantesimo giorno dal caricamento, e da li' in poi la verifica non si rifa' piu': resta l'ultimo esito, riassunto nella storia"
    },
    "esito_json": {
      "type": "string",
      "description": "Esito riga per riga, con il tipo ingresso o uscita, e movimenti del gestionale assenti nel report. Si toglie al quarantesimo giorno dal caricamento: quello che serve dopo (formulari e chili per canale, chi non tornava) finisce nella storia"
    },
    "righe_report": {
      "type": "number"
    },
    "conformi": {
      "type": "number"
    },
    "con_discrepanze": {
      "type": "number"
    },
    "non_trovate": {
      "type": "number"
    },
    "duplicate": {
      "type": "number"
    },
    "assenti_nel_report": {
      "type": "number"
    },
    "uscite_verificate": {
      "type": "boolean",
      "description": "Il report contiene uscite e quelle della settimana sono state controllate. Se falso, il report riporta i soli ingressi. Formulari e chili, ingressi e uscite, stanno nella quadratura di esito_json per movimentazione e canale: i totali che sommavano rete, ACI ed extra raccolta non si salvano piu'"
    },
    "conformita": {
      "type": "string",
      "enum": ["piena", "parziale"],
      "description": "piena: nessuna anomalia e formulari e pesi che quadrano con il gestionale; parziale: errori, sviste o mancanze"
    },
    "per_canale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canale": { "type": "string" },
          "nome": { "type": "string" },
          "conformita": { "type": "string" },
          "anomalie": { "type": "number" },
          "assenti": { "type": "number" }
        }
      },
      "description": "Il verdetto per canale (rete, aci, extra), solo dei canali con almeno un formulario: rete, ACI ed extra raccolta non si sommano. conformita e' il verdetto unico, che resta per l'alert della dichiarazione di nessuna movimentazione"
    },
    "anomalie": {
      "type": "number",
      "description": "Righe con errori o sviste dell'impianto, piu' i formulari mancanti nel report. Comprende le righe dei formulari registrati senza una data obbligatoria (immissione, inizio o fine trasporto) o con date incoerenti: dal 22/09/2026 sono anomalie del loro canale, non rettifiche"
    },
    "date_da_sistemare": {
      "type": "number",
      "description": "Formulari registrati senza una data obbligatoria (immissione, inizio o fine trasporto) o con date incoerenti, fra le righe del report e i movimenti assenti nel report: le date vanno inserite o corrette (regola del 22/09/2026)"
    },
    "osservazioni": {
      "type": "number",
      "description": "Righe con soli nomi scritti in modo diverso: non incidono sulla conformita'"
    },
    "rettifiche": {
      "type": "number",
      "description": "Righe in cui l'errore e' nei dati del portale e non nel report"
    },
    "righe_escluse": {
      "type": "number",
      "description": "Righe del report non considerate: carichi di altri consorzi e righe senza formulario. I carichi di altre settimane NON si escludono piu' (01/10/2026): si verificano e si contano in fuori_settimana"
    },
    "fuori_settimana": {
      "type": "number",
      "description": "Righe del report che appartengono a un'altra settimana e che vengono verificate comunque (regola dell'utente del 01/10/2026): un carico rimasto fuori dal report della sua settimana si vede solo cosi'"
    },
    "arretrati_da_registrare": {
      "type": "number",
      "description": "Formulari di settimane precedenti che nel gestionale non risultano: vanno caricati a portale, e il termine di registrazione (dieci giorni dalla partenza, domeniche escluse) potrebbe essere scaduto. E' la mancanza piu' grave che una verifica possa trovare"
    },
    "settimane_arretrate": {
      "type": "string",
      "description": "Le settimane precedenti a cui appartengono le righe comparse in questo report, per esempio \"37, 38\""
    },
    "peso_escluse_kg": {
      "type": "number"
    },
    "verificata_il": {
      "type": "string",
      "format": "date-time"
    },
    "scade_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui alla verifica viene tolto il dettaglio: quaranta giorni dopo il caricamento. Il record NON si cancella piu' (richiesta dell'utente, 29/09/2026): restano i numeri di sintesi, il verdetto per canale e la storia scritta"
    },
    "storia": {
      "type": "string",
      "description": "La storia scritta del documento, in italiano: resta per sempre. Si scrive quando il dettaglio viene tolto, al quarantesimo giorno dal caricamento (base44/shared/conservazione.ts). E' un campo normale e non passa mai da valoreCampo: se sfondasse gli ottomila caratteri tornerebbe in ContenutoEsteso, cioe' il peso che si e' appena tolto"
    },
    "alleggerito_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui sono stati tolti le righe lette e il confronto riga per riga. Finche' e' vuoto il documento ha ancora tutto il suo dettaglio"
    },
    "file_uri": {
      "type": "string",
      "description": "Il PDF o l'immagine caricati nell'archivio privato perche' l'agente li leggesse. Si cancella subito dopo la lettura e il campo torna vuoto: resta scritto solo se quella cancellazione non e' riuscita, cosi' la pulizia notturna puo' riprovare invece di lasciare in giro un file che nessuno sa piu' di avere"
    }
  },
  "required": [
    "soggetto_chiave",
    "anno",
    "settimana"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
