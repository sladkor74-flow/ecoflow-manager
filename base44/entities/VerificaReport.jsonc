{
  "name": "VerificaReport",
  "type": "object",
  "properties": {
    "soggetto_chiave": {
      "type": "string",
      "description": "Ragione sociale normalizzata dell'impianto o dello stoccaggio che ha inviato il report"
    },
    "soggetto_nome": {
      "type": "string"
    },
    "anno": {
      "type": "number",
      "description": "Anno della settimana secondo la numerazione ISO"
    },
    "settimana": {
      "type": "number"
    },
    "data_inizio": {
      "type": "string",
      "format": "date"
    },
    "data_fine": {
      "type": "string",
      "format": "date"
    },
    "file_nome": {
      "type": "string"
    },
    "nota": {
      "type": "string",
      "description": "Per una dichiarazione di nessuna movimentazione: riferimento della comunicazione dell'impianto (email, data, mittente)"
    },
    "file_tipo": {
      "type": "string",
      "enum": [
        "excel",
        "csv",
        "pdf",
        "immagine",
        "dichiarazione"
      ],
      "description": "Il file non viene conservato: se ne salvano solo i dati letti, cosi' alla cancellazione non resta nulla in archivio"
    },
    "stato": {
      "type": "string",
      "enum": [
        "in_lettura",
        "in_verifica",
        "completata",
        "errore"
      ],
      "default": "in_lettura"
    },
    "avviata_il": {
      "type": "string",
      "format": "date-time"
    },
    "errore": {
      "type": "string"
    },
    "lettura_json": {
      "type": "string",
      "description": "Come e' stato letto il file: foglio, colonne riconosciute, unita' di misura, note dell'agente"
    },
    "righe_report_json": {
      "type": "string",
      "description": "Righe del report gia' normalizzate: servono a ripetere la verifica senza rileggere il file"
    },
    "esito_json": {
      "type": "string",
      "description": "Esito riga per riga, con il tipo ingresso o uscita, e movimenti del gestionale assenti nel report"
    },
    "righe_report": {
      "type": "number"
    },
    "conformi": {
      "type": "number"
    },
    "con_discrepanze": {
      "type": "number"
    },
    "non_trovate": {
      "type": "number"
    },
    "duplicate": {
      "type": "number"
    },
    "assenti_nel_report": {
      "type": "number"
    },
    "uscite_verificate": {
      "type": "boolean",
      "description": "Il report contiene uscite e quelle della settimana sono state controllate. Se falso, il report riporta i soli ingressi. Formulari e chili, ingressi e uscite, stanno nella quadratura di esito_json per movimentazione e canale: i totali che sommavano rete, ACI ed extra raccolta non si salvano piu'"
    },
    "conformita": {
      "type": "string",
      "enum": ["piena", "parziale"],
      "description": "piena: nessuna anomalia e formulari e pesi che quadrano con il gestionale; parziale: errori, sviste o mancanze"
    },
    "per_canale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canale": { "type": "string" },
          "nome": { "type": "string" },
          "conformita": { "type": "string" },
          "anomalie": { "type": "number" },
          "assenti": { "type": "number" }
        }
      },
      "description": "Il verdetto per canale (rete, aci, extra), solo dei canali con almeno un formulario: rete, ACI ed extra raccolta non si sommano. conformita e' il verdetto unico, che resta per l'alert della dichiarazione di nessuna movimentazione"
    },
    "anomalie": {
      "type": "number",
      "description": "Righe con errori o sviste dell'impianto, piu' i formulari mancanti nel report"
    },
    "osservazioni": {
      "type": "number",
      "description": "Righe con soli nomi scritti in modo diverso: non incidono sulla conformita'"
    },
    "rettifiche": {
      "type": "number",
      "description": "Righe in cui l'errore e' nei dati del portale e non nel report"
    },
    "righe_escluse": {
      "type": "number",
      "description": "Righe del report non considerate: carichi di altre settimane o di altri consorzi"
    },
    "peso_escluse_kg": {
      "type": "number"
    },
    "verificata_il": {
      "type": "string",
      "format": "date-time"
    },
    "scade_il": {
      "type": "string",
      "format": "date",
      "description": "Giorno in cui la verifica viene cancellata: quaranta giorni dopo il caricamento"
    }
  },
  "required": [
    "soggetto_chiave",
    "anno",
    "settimana"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
