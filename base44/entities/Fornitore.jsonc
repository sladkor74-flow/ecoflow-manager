{
  "name": "Fornitore",
  "type": "object",
  "properties": {
    "ragione_sociale": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "trasportatore",
        "impianto",
        "stoccaggio",
        "altro"
      ],
      "default": "altro",
      "description": "DEPRECATO - sostituito dai campi ruolo_*. Mantenuto per retrocompatibilita'."
    },
    "ruolo_raccolta": {
      "type": "boolean",
      "default": false
    },
    "ruolo_trasporto_secondaria": {
      "type": "boolean",
      "default": false
    },
    "ruolo_trattamento": {
      "type": "boolean",
      "default": false
    },
    "ruolo_stoccaggio": {
      "type": "boolean",
      "default": false
    },
    "interno": {
      "type": "boolean",
      "default": false,
      "description": "Societa' del gruppo: compare nei riepiloghi con le tonnellate ma non viene fatturata, perche' non si puo' fatturare a se stessi."
    },
    "piva": {
      "type": "string"
    },
    "codice_fiscale": {
      "type": "string"
    },
    "indirizzo": {
      "type": "string"
    },
    "cap": {
      "type": "string"
    },
    "comune": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "regione": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "ragione_sociale"
  ]
}