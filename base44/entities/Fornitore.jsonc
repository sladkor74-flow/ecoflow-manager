{
  "name": "Fornitore",
  "type": "object",
  "properties": {
    "ragione_sociale": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "trasportatore",
        "impianto",
        "stoccaggio",
        "altro"
      ],
      "default": "altro",
      "description": "DEPRECATO - sostituito dai campi ruolo_*. Mantenuto per retrocompatibilita'."
    },
    "ruolo_raccolta": {
      "type": "boolean",
      "default": false
    },
    "ruolo_trasporto_secondaria": {
      "type": "boolean",
      "default": false
    },
    "ruolo_trattamento": {
      "type": "boolean",
      "default": false
    },
    "ruolo_stoccaggio": {
      "type": "boolean",
      "default": false
    },
    "trattamento_fatturato_da_ecotyre": {
      "type": "boolean",
      "default": false,
      "description": "Impianto il cui trattamento viene pagato da Ecotyre direttamente: sulle consegne a questo impianto SMOCO percepisce il solo trasporto. Corrisponde alla voce Trasp della prefattura."
    },
    "interno": {
      "type": "boolean",
      "default": false,
      "description": "Societa' del gruppo: compare nei riepiloghi con le tonnellate ma non viene fatturata, perche' non si puo' fatturare a se stessi."
    },
    "fattura_tramite_id": {
      "type": "string",
      "description": "Subfornitore: il fornitore principale sotto cui lavora. Vuoto per chi fattura in proprio."
    },
    "fattura_tramite_nome": {
      "type": "string",
      "description": "Ragione sociale del fornitore principale che fattura anche le prestazioni di questo soggetto. Nella fatturazione le sue tonnellate si accorpano al principale, con la tariffa del principale, e restano visibili come 'di cui'; nei formulari e nei target il soggetto resta se stesso."
    },
    "piva": {
      "type": "string"
    },
    "codice_fiscale": {
      "type": "string"
    },
    "indirizzo": {
      "type": "string"
    },
    "cap": {
      "type": "string"
    },
    "comune": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "regione": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "stato": {
      "type": "string",
      "enum": [
        "attivo",
        "non_attivo"
      ],
      "default": "attivo"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "ragione_sociale"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}