{
  "name": "RiepilogoQualifica",
  "type": "object",
  "properties": {
    "anno": {
      "type": "number"
    },
    "alert_aperti": {
      "type": "number",
      "description": "Requisiti che richiedono un intervento: scaduti, non conformi, mancanti, in scadenza o da verificare. E' il numero mostrato accanto alla voce del menu"
    },
    "soggetti_con_alert": {
      "type": "number"
    },
    "scaduti": {
      "type": "number"
    },
    "non_conformi": {
      "type": "number"
    },
    "mancanti": {
      "type": "number"
    },
    "in_scadenza": {
      "type": "number"
    },
    "anomalie_catalogo": {
      "type": "number",
      "description": "Voci del catalogo che non chiederanno mai niente a nessuno: intestate a un fornitore che nell'anno non risulta, oppure senza ne' ruolo ne' fornitore. La dashboard le legge da qui"
    },
    "anomalie_catalogo_testo": {
      "type": "string",
      "description": "I nomi di quelle voci, per la dashboard"
    },
    "da_verificare": {
      "type": "number"
    },
    "soggetti_critici": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "I soggetti con almeno un documento scaduto o non conforme: nome, chiave, elenco dei documenti. Lo legge la fatturazione passiva per avvisare prima di pagare, senza ricalcolare la qualifica"
    },
    "aggiornato_il": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "anno"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
